<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1.0" client="site" method="upgrade">
    <name>Ergasia Jobs</name>
    <author>e-logsim</author>
    <version>2.0.0</version>
    <description>Jobs counter by categories</description>
    <files>
        <filename>mod_elgergasiajobs.xml</filename>
        <filename module="mod_elgergasiajobs">mod_elgergasiajobs.php</filename>
        <filename>index.html</filename>
        <filename>helper.php</filename>
        <filename>tmpl/default.php</filename>
        <filename>tmpl/index.html</filename>
    </files>
    <config>
        <fields name="params">
                <fieldset name="basic">
                        <field name="idSpeciality" type="sqlLang" default="1" label="Select a speciality" query="select idSpeciality as value, speciality as idSpeciality from #__elg_ergasia_speciality_translation where {language} and id > 0 order by speciality " />
                         <field
                    name="moduleclass_sfx"
                    type="textarea" rows="3"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
                </fieldset>
        </fields>
        

    </config>
</extension>