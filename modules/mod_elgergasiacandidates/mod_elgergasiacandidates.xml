<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.1.0" client="site" method="upgrade">
    <name>Ergasia Candidates</name>
    <author>e-logsim</author>
    <version>2.0.0</version>
    <description>Candidate counter by speciality</description>
    <files>
        <filename>mod_elgergasiacandidates.xml</filename>
        <filename module="mod_elgergasiacandidates">mod_elgergasiacandidates.php</filename>
        <filename>index.html</filename>
        <filename>helper.php</filename>
        <filename>tmpl/default.php</filename>
        <filename>tmpl/index.html</filename>
    </files>
    <config>
        <fields name="params" addfieldpath="../administrator/models/fields" >
                <fieldset name="basic">
                        <field name="idSpeciality" type="sql" default="1" label="Select a speciality" 
                        query="select idSpeciality as value, speciality as idSpeciality from #__elg_ergasia_speciality_translation where language='el-GR' and idSpeciality > 0 order by speciality " />
                        
                <field
                    name="moduleclass_sfx"
                    type="textarea" rows="3"
                    label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
                    description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
                </fieldset>
        </fields>
        

    </config>
</extension>