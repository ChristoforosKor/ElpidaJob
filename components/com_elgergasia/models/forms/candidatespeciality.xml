<form>
	<fields>
            <fieldset name="basicset" label="COM_ELGERGASIA_CANDIDATE_SPECIALITIES" >
                <field name="id" type="hidden" />
                <field name="idUser" type="hidden" />
                
                <field
                    name="idSpeciality"
                    type="sqlLang"
                    description="COM_ELGERGASIA_CANDIDATE_SPECIALITY_DESC"
                    label="COM_ELGERGASIA_CANDIDATE_SPECIALITY"
                    query = "select idSpeciality as value, speciality as idSpeciality from #__elg_ergasia_speciality_translation where {language} order by speciality "
                    class="form-control"
                >
                </field>
                 <field
                    name="experience"
                    type="text"
                    description="COM_ELGERGASIA_CANDIDATE_EXPERIENCE_MONTH_DESC"
                    filter="string"
                    label="COM_ELGERGASIA_CANDIDATE_EXPERIENCE_MONTH"
                    size="30"
                    class="form-control"
                />
                <field
                    name="idRank"
                    type="sqlLang"
                    description="COM_ELGERGASIA_CANDIDATE_SPECIALITY_RANK_DESC"
                    label="COM_ELGERGASIA_CANDIDATE_SPECIALITY_RANK"
                    query = "select r.id as value, rt.rankFem as idRank from #__elg_rank r inner join #__elg_rank_translation rt on r.id = rt.idRank  and {language} order by r.ordering "
                    class="form-control"
                >
                </field>
                
            </fieldset>
	</fields>
</form>
