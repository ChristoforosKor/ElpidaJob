                    name="idCountry"
                    type="sql"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_COUNTRY_DESC"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_COUNTRY_LABEL"
                    query ="select id as value, name as idCountry from #__elg_ergasia_countries order by ordering, name"
                >
                    
