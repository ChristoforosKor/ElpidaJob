<form>
	<fields>
            <fieldset name="basicset" label="COM_ELGERGASIA_CANDIDATE_EDUCATION" >
                <field name="id" type="hidden" />
                <field name="idUser" type="hidden" />
                <field name="language" type="hidden" />
                <field
                    name="educationTitle"
                    type="text"
                    label="COM_ELGERGASIA_EDUCATION_TITLE"
                    filter="string"
                    description="COM_ELGERGASIA_EDUCATION_TITLE_DESC"
                    size="30"
                    class="form-control"
                />
                <field
                    name="educationInstitute"
                    type="text"
                    label="COM_ELGERGASIA_INSTITUTION"
                    filter="string"
                    description="COM_ELGERGASIA_INSTITUTION_DESC"
                    size="30"
                    class="form-control"
                />
                          
                <field
                    name="idDegreeLevel"
                    type="sqlLang"
                    description="COM_ELGERGASIA_DEGREE_LEVEL_DESC"
                    label="COM_ELGERGASIA_LEVEL"
                    query ="select id as value, degreeLevel as idDegreeLevel from #__elg_ergasia_degree_level d inner join #__elg_ergasia_degree_level_translation dt on d.id = dt.idDegreeLevel and {language} order by ordering, degreeLevel"
                    class="form-control"
                >
                   
                </field>
                <field
                    name="idSpecialization"
                    type="sqlLang"
                    description="COM_ELGERGASIA_VIEW_CANDIDATE_SPECIALIZATION_SECTOR_DESC"
                    label="COM_ELGERGASIA_VIEW_CANDIDATE_SPECIALIZATION_SECTOR"
                    query ="select idSpeciality as value, speciality as idSpecialization from #__elg_ergasia_speciality_translation where {language} order by speciality"
                    class="form-control"
                />
               
                <!-- field
                    name="monthFrom"
                    type="integer"
                    first="1"
                    last="12"
                    step="1"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_MONTH_FROM_DESC"
                 
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_MONTH_FROM_LABEL"
                    
		/ -->
                <field
                    name="yearFrom"
                    type="integer"
                    first="1970"
                    last="2020"
                    step="1"
                    description="COM_ELGERGASIA_CANDIDATE_EDUCATION_YEAR_FROM_DESC"
                    label="COM_ELGERGASIA_YEAR_FROM"
                    class="form-control"
		/>
                <!-- field
                    name="monthTo"
                    type="integer"
                    first="1"
                    last="12"
                    step="1"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_MONTH_TO_DESC"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_MONTH_TO_LABEL"
                    
		/ -->
                <field
                    name="yearTo"
                    type="integer"
                    first="1970"
                    last="2020"
                    step="1"
                    description="COM_ELGERGASIA_CANDIDATE_EDUCATION_YEAR_TO_DESC"
                    label="COM_ELGERGASIA_YEAR_TO"
                    class="form-control"
		/>
                
            </fieldset>
	</fields>
</form>
