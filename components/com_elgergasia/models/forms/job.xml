<form> 
	<fields>
            <fieldset>
             
                <field name="id" type="hidden"  />
                <field name="submitDate" type="hidden"  />
                <field name="language" type="hidden" />
                 <field 
                    name="idJobState" 
                    type="sqlLang"
                    label="COM_ELGERGASIA_STATE"
                    query="select id, jobState from #__elg_ergasia_jobstates  where {language}"
                    value_field="jobState"
                    key_field="id"
                    class="form-control"
                />
                <field name="extUrl" type="text" label="COM_ELGERGASIA_EXTERNAL_URL"  class="form-control"/>
                <field name="jobTitle" type="text" label="COM_ELGERGASIA_JOBS_LISTING_TITLE" required="true" class="form-control"/>
                <field name="jobCost" type="text" label="COM_ELGERGASIA_JOBS_COST" required="true" class="form-control"/>
                <field 
                    name="idCounty" 
                    label="COM_ELGERGASIA_JOB_PLACE"
                    type="sqlLang"
                    query="select idCounty, county from #__elg_county_translation where {language} order by county"
                    value_field="county"
                    key_field="idCounty"
                    required="true"
                    class="form-control"
                >
                    <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                <field 
                    name="idSpeciality" 
                    label="COM_ELGERGASIA_CANDIDATE_SPECIALITY"
                    type="sqlLang"
                    query="select id, speciality from #__elg_ergasia_speciality s inner join #__elg_ergasia_speciality_translation st on s.id = st.idSpeciality and {language} where  id>0 order by ordering, speciality"
                    value_field="speciality"
                    key_field="id"
                    class="form-control"
                >
                     <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                <field 
                    name="idUser" 
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_EMPLOYER"
                    type="sqlLang"
                    query="select e.idUser, concat(et.discreteTitle, ' - ', e.phone) as discreteTitle  from #__elg_ergasia_employer e inner join #__elg_ergasia_employer_translation et on e.id = et.idEmployer where language='el-GR' order by discreteTitle"
                    value_field="discreteTitle"
                    key_field="idUser"
                    required="true"
                    class="form-control"
                >
                    <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                           
                <field 
                name="idDegreeLevel" 
                type="sqlLang" 
                label="COM_ELGERGASIA_JOB_EDIT_EDUCATION"
                query="select id, degreeLevel  from #__elg_ergasia_degree_level d inner join #__elg_ergasia_degree_level_translation dt on d.id = dt.idDegreeLevel and {language}  where id > 0 order by ordering"
                value_field="degreeLevel"
                key_field="id"
                class="form-control"
                >
                     <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                <field
                    name="idHour"
                    type="sql"
                    label="COM_ELGERGASIA_HOURS"
                    query ="select id as value, hour as idHour  from #__elg_ergasia_hour  order by ordering, hour"
                    class="form-control"
                    required="true"
                >
                     <option value="">COM_ELGERGASIA_SELECT</option>
                </field>
                <field
                    name="idMedicalCare"
                    type="sql"
                    label="COM_ELGERGASIA_MEDICAL_CARE"                       
                    query ="select id as value, medicalCare as idMedicalCare  from #__elg_ergasia_medicalcare order by id"
                    class="form-control"
                >
                    <option value="">COM_ELGERGASIA_SELECT</option>
                </field>
                <field
                    name="idOldPeople"
                    type="sql"
                    label="COM_ELGERGASIA_OLD_PEOPLE"                   
                    query ="select id as value, oldPeople as idOldPeople  from #__elg_ergasia_oldpeople order  by id"
                     class="form-control"
                >
                    <option value="">COM_ELGERGASIA_SELECT</option>
                </field>
                <field name="daysOff" type="text" label="COM_ELGERGASIA_DAYS_OFF"  required="true" class="form-control" />
                
                <field name="minExperience" type="text" label="COM_ELGERGASIA_JOB_EDIT_EXPERIENCE"  required="true" class="form-control" />
                <field name="jobSalary" type="text" label="COM_ELGERGASIA_SALARY"   class="form-control" />
                <field name="jobDescription" type="textarea" cols="50" rows="10" label="COM_ELGERGASIA_JOB_EDIT_DESCRIPTION"  required="true" class="form-control" />
                <field name="jobComment" type="textarea" cols="50" rows="10" label="COM_ELGERGASIA_JOB_EDIT_COMMENT" class="form-control" />
                <field name="jobImage1" type="file" label="Image 1" size="10"  class="form-control" />
                <field name="jobImage2" type="file" label="Image 2" size="10" class="form-control" />
                <field name="jobImage3" type="file" label="Image 3" size="10"  class="form-control" />
           </fieldset>
	</fields>
</form>
