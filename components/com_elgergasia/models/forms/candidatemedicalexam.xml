<form>
	
            <fieldset>
                <field name="id" type="hidden" />
                <field name="idUser" type="hidden" />
                <field name="language" type="hidden" />
                <field
                    name="examTitle"
                    type="text"
                    label="COM_ELGERGASIA_TITLE"
                    required="true"
                    class="form-control"
                />
                
                 <field
                    name="examFile"
                    type="file"
                    label="COM_ELGERGASIA_FILE"
                    required="true"
                    class="form-control"
                />
                <field
                    name="examDate"
                    type="Calendar"
                    label="COM_ELGERGASIA_EXAM_DATE"
                    class="calendar-form-control"   
                    format="%d/%m/%Y"              
                >
                </field>
                
            </fieldset>
	
</form>
