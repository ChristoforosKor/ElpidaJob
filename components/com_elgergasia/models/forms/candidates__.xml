<form>
	<fields >
            <fieldset name="userset" label="COM_ELGERGASIA_VIEW_EMPLOYEE_LOGIN_DATA" >
                <field
                    name="idUser"
                    type="text"
                    label="COM_ELGERGASIA_ID"
                    description="COM_ELGERGASIA_FILTER_CANDIDATE_ID"
                 />
                <field
                    name="fullname"
                    type="text"
                    label="COM_ELGERGASIA_VIEW_CANDIDATE_FULLNAME"
                    description="COM_ELGERGASIA_FILTER_CANDIDATE_FULLNAME_DESC"
                 />
                 <field
                    name="username"
                    type="text"
                    label="COM_ELGERGASIA_VIEW_CANDIDATE_USERNAME"
                    
                 />
                 <field
                    name="email"
                    type="text"
                    label="COM_ELGERGASIA_EMAIL"
                    size="30"
                 />
            </fieldset>
            <fieldset name="basicset" label="COM_ELGERGASIA_VIEW_EMPLOYEE_CONTACT_DATA" >
                 
                <field
                    name="idCountry"
                    type="sqlLang"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_COUNTRY_LABEL"
                    query ="select c.id as value, ct.country as idCountry from #__elg_country c inner join #__elg_country_translation ct on c.id = ct.idCountry where {language} order by ordering, name"
                />
                     
                
             
                
                <field
                    name="city"
                    type="text"
                    filter="string"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_CITY_LABEL"
                    description="COM_ELGERGASIA_FILTER_CANDIDATE_CITY_DESC"
                    size="30"
                />
                <!-- field
                    name="region"
                    type="text"
                    id="region"
                    description="PLG_USER_ERGASIA_FIELD_REGION_DESC"
                    filter="string"
                    label="PLG_USER_ERGASIA_FIELD_REGION_LABEL"
                    size="30"
		/ -->
                <field
                    name="address"
                    type="text"
                    id="address"                  
                    filter="string"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_ADDRESS_LABEL"
                    size="30"
		/>
                <field
                    name="postalCode"
                    type="text"                 
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_POSTAL_CODE_LABEL"
                    size="30"
		/>
                <field
                    name="telephone" 
                    type="text"                
                     label="COM_ELGERGASIA_VIEW_EMPLOYEE_PHONE_LABEL"
                    size="30"
		/>
               
                
            </fieldset>
            
            <fieldset name="personalset"  label="COM_ELGERGASIA_VIEW_EMPLOYEE_CHARACTERISTICS_DATA" >
                
                 <field name="idGender" 
                        default="0" 
                        label="COM_ELGERGASIA_VIEW_EMPLOYEE_GENDER" 
                        description="COM_ELGERGASIA_VIEW_EMPLOYEE_GENDER_DESC"
                        type="sql" 
                      
                        query="select id as value, gender as idGender from #__elg_ergasia_genders order by gender"
                />
                <field
                    name="dateOfBirth"
                    type="calendar"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_FIELD_DOB"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_DOB_DESC"
                />
              
               <field
                    name="idNationality"
                    type="sqlLang"
                    description="COM_ELGERGASIA_VIEW_CANDIDATE_NATIONALITY_DESC"
                    filter="string"
                    label="COM_ELGERGASIA_VIEW_CANDIDATE_NATIONALITY_LABEL"
                   
                    query = "select idCountry as value, name as idNationality  from #__elg_country_translation where {language} order by ordering, name "
                >
              
               </field>    
                <field
                    name="idMilitaryStatus"
                    type="sql"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_MILITARYSTATUS_DESC"
                    filter="string"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_MILITARYSTATUS_LABEL"
                    
                    query = "select id as value, militaryStatus as idMilitaryStatus from #__elg_ergasia_militarystatuses order by ordering, militaryStatus "
                /> 
                <field
                    name="idMaritalStatus"
                    type="sql"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_MARITALSTATUS_DESC"
                    filter="string"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_MARITALSTATUS_LABEL"
                   
                    query = "select id as value, maritalStatus as idMaritalStatus from #__elg_ergasia_maritalstatuses order by ordering "
                />    
               <field
                    name="childrenNum"
                    type="text"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_CHILDRENNUM_LABEL"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_CHILDRENNUM_DESC"
                    
                />
                <field
                    name="idReligion"
                    type="sql"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_RELIGION_DESC"
                    filter="string"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_RELIGION_LABEL"
                     query = "select id as value, religion as idReligion from #__elg_ergasia_religions order by ordering "
                />
                <field name="smoking" type="list"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_SMOKING_LABEL" 
                       description="COM_ELGERGASIA_VIEW_EMPLOYEE_SMOKING_DESC">
                    <option value="0">COM_ELGERGASIA_VIEW_EMPLOYEE_NO_SELECTION</option>
                    <option value="1">JNO</option>
                    <option value="2">JYES</option>
                </field>
                <field
                    name="idPetFriend"
                    type="sql"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_PET_DESC"
                    filter="string"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_PET_LABEL"
                    query = "select id as value, rankFem as idPetFriend from #__elg_ergasia_ranks order by ordering "
                >
                
                </field>
           </fieldset>
           
           <fieldset name="experienceset" label="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_DATA" >
             
                <field
                    name="idIndustry"
                    type="sqlLang"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_INDUSTRY_DESC"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_INDUSTRY"
                    query ="select idIndustry as value, industry as idIndustry from #__elg_ergasia_industry_translation where {language} order by industry"
                >
                   
                </field>
                <field
                    name="idSpecialization"
                    type="sqlLang"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_SECTOR_DESC"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_EXPERIENCE_SECTOR"
                    query ="select idSpeciality as value, speciality as idSpecialization from #__elg_ergasia_speciality_translation where {language} order by ordering, speciality"
                />
                <field
                    name="employerTitle"
                    type="text"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_EMPLOYER_DESC"
                    class="elg-input-wide"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_EMPLOYER"
                   
		/>
             
            </fieldset> 
            
           <fieldset name="specialitiesset" label="COM_ELGERGASIA_VIEW_EMPLOYEE_SPECIALITIES_DATA" >
             
               <field
                    name="idSpecialitySpecilities"
                    type="sql"
                    description="COM_ELGERGASIA_CANDIDATE_SPECIALITY_DESC"
                    label="COM_ELGERGASIA_CANDIDATE_SPECIALITY"
                    query = "select id as value, speciality as idSpecialitySpecilities from #__elg_ergasia_speciality_translation where {language} order by speciality "
                >
                     <option value="0">COM_ELGERGASIA_VIEW_EMPLOYEE_NO_SELECTION</option>
                </field>
                 <field
                    name="experienceSpecialities"
                    type="text"
                    description="COM_ELGERGASIA_CANDIDATE_EXPERIENCE_MONTH_DESC"
                    filter="number"
                    label="COM_ELGERGASIA_CANDIDATE_EXPERIENCE_MONTH"
                    size="30"
                />
                <field
                    name="idRankSpecialities"
                    type="sql"
                    description="COM_ELGERGASIA_CANDIDATE_SPECIALITY_RANK_DESC"
                    label="COM_ELGERGASIA_CANDIDATE_SPECIALITY_RANK"
                    query = "select id as value, rankFem as idRankSpecialities from #__elg_ergasia_ranks order by ordering "
                >
                </field>
            </fieldset>
            
            <fieldset name="educationset" label="COM_ELGERGASIA_VIEW_EMPLOYEE_EDUCATION_DATA" >
             
               <field
                    name="educationTitle"
                    type="text"
                    label="COM_ELGERGASIA_EDUCATION_TITLE"
                    filter="string"
                    description="COM_ELGERGASIA_EDUCATION_TITLE_DESC"
                    size="30"
                />
                <field
                    name="educationInstitute"
                    type="text"
                    label="COM_ELGERGASIA_INSTITUTION"
                    filter="string"
                    description="COM_ELGERGASIA_INSTITUTION_DESC"
                    size="30"
                />
                     
                
                          
                <field
                    name="idDegreeLevel"
                    type="sql"
                    description="COM_ELGERGASIA_DEGREE_LEVEL_DESC"
                    label="COM_ELGERGASIA_LEVEL"
                    query ="select id as value, degreeLevel as idDegreeLevel from #__elg_ergasia_degree_level order by ordering"
                >
                    <option value="0">COM_ELGERGASIA_VIEW_EMPLOYEE_NO_SELECTION</option>
                </field>
                <field
                    name="idSpecializationEducation"
                    type="sql"
                    description="COM_ELGERGASIA_VIEW_CANDIDATE_SPECIALIZATION_SECTOR_DESC"
                    label="COM_ELGERGASIA_VIEW_CANDIDATE_SPECIALIZATION_SECTOR"
                    query ="select id as value, speciality as idSpecializationEducation from #__elg_ergasia_speciality_translation whre {language} order by speciality"
                >
                     <option value="0">COM_ELGERGASIA_VIEW_EMPLOYEE_NO_SELECTION</option>
                </field>
            </fieldset>
            <fieldset name="languageset" label="COM_ELGERGASIA_VIEW_EMPLOYEE_SPOKEN_LANGUAGE_DATA" >
             
               <field
                    name="spokenLanguage"
                    type="text"
                    description="COM_ELGERGASIA_SPOKEN_LANGUAGE_DESC"
                    filter="string"
                    label="COM_ELGERGASIA_SPOKEN_LANGUAGE"
                    size="30"
                />
                <field
                    name="idRankLanguage"
                    type="sql"
                    description="COM_ELGERGASIA_CANDIDATE_SPECIALITY_RANK_DESC"
                    label="COM_ELGERGASIA_CANDIDATE_SPECIALITY_RANK"
                    query = "select id as value, rankFem as idRankLanguage from #__elg_ergasia_ranks order by ordering "
                >
                </field>
            </fieldset>
            

	</fields>
</form>
