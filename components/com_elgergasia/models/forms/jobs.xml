<form> 
	<fields addfieldpath="/components/com_elgergasia/models/fields/" >
             <field name="id" type="text" label="COM_ELGERGASIA_ID"   class="form-control" />
             <field name="submitDate" type="calendar" label="COM_ELGERGASIA_FILTER_DATE_FROM"   class="calendar-form-control" format="%d/%m/%Y" />
             <field name="submitDateTo" type="calendar" label="COM_ELGERGASIA_JOBS_LISTING_DATE_TΟ"   class="calendar-form-control" format="%d/%m/%Y" />
            <field
                    required="true"
                    name="dateOfBirth"
                    type="calendar"
                    label="COM_ELGERGASIA_VIEW_EMPLOYEE_FIELD_DOB"
                    description="COM_ELGERGASIA_VIEW_EMPLOYEE_DOB_DESC"
                    class="form-control"
                />
            
            
            <fieldset>
                <field name="idUser" type="sql" 
                label="COM_ELGERGASIA_VIEW_EMPLOYEE_EMPLOYER"
                query="select id , name from #__users where id in (select user_id from #__user_usergroup_map where group_id = 11) and id > 0 order by name"
                value_field="name"
                key_field="id"
                class="form-control"
                >
                      <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                <field 
                name="idIndustry" 
                type="sqlLang" 
                label="COM_ELGERGASIA_JOBS_INDUSTRY"
                query ="select id as value, industry as idIndustry from #__elg_ergasia_industry i inner join #__elg_ergasia_industry_translation it on i.id = it.idIndustry and {language} order by ordering, industry"
                class="form-control"
                
                >
                      <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                  <field 
                    name="idSpeciality" 
                    label="COM_ELGERGASIA_CANDIDATE_SPECIALITY"
                    type="sqlLang"
                    query="select id, speciality from #__elg_ergasia_speciality s inner join  #__elg_ergasia_speciality_translation st on s.id = st.idSpeciality  and {language} where id > 0  order by ordering, speciality"
                    value_field="speciality"
                    key_field="id"
                    class="form-control"
                >
                     <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                 <field name="idJobState" type="sql" 
                label="COM_ELGERGASIA_JOB_STATE"
                query="select id, jobState  from #__elg_ergasia_jobstates where id > 0 and language ='el-GR'"
                value_field="jobState"
                key_field="id"
                class="form-control"
                >
                      <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
                <field name="jobTitle" type="text" 
                label="COM_ELGERGASIA_JOBS_LISTING_TITLE"
                value_field="industry"
                key_field="id"
                class="form-control"
                />
                 <field name="employer" type="text" label="COM_ELGERGASIA_VIEW_EMPLOYEE_EMPLOYER"   class="form-control" />
                 <field name="jobSalary" type="text" label="COM_ELGERGASIA_SALARY_FROM"   class="form-control" />
                 <field name="jobSalaryTo" type="text" label="COM_ELGERGASIA_SALARY_TO"   class="form-control" />
                 <field
                    name="idOldPeople"
                    type="sql"
                    label="COM_ELGERGASIA_OLD_PEOPLE"                   
                    query ="select id as value, oldPeople as idOldPeople  from #__elg_ergasia_oldpeople order  by id"
                     class="form-control"
                >
                    <option value="">COM_ELGERGASIA_SELECT</option>
                </field>
                <field name="daysOff" type="text" label="COM_ELGERGASIA_DAYS_OFF_FROM"   class="form-control" />
                <field name="daysOffTo" type="text" label="COM_ELGERGASIA_DAYS_OFF_TO"   class="form-control" />
                <field
                    name="idMedicalCare"
                    type="sql"
                    label="COM_ELGERGASIA_MEDICAL_CARE"                       
                    query ="select id as value, medicalCare as idMedicalCare  from #__elg_ergasia_medicalcare order by id"
                    class="form-control"
                >
                    <option value="">COM_ELGERGASIA_SELECT</option>
                </field>
                  <field
                    name="idHour"
                    type="sql"
                    label="COM_ELGERGASIA_HOURS"
                    query ="select id as value, hour as idHour  from #__elg_ergasia_hour  order by ordering, hour"
                    class="form-control"
                    
                >
                     <option value="">COM_ELGERGASIA_SELECT</option>
                </field>
                
                 <field 
                    name="idCounty" 
                    label="COM_ELGERGASIA_JOB_PLACE"
                    type="sqlLang"
                    query="select idCounty, county from #__elg_county_translation where {language} order by county"
                    value_field="county"
                    key_field="idCounty"
                    
                    class="form-control"
                >
                    <option value="">COM_ELGERGASIA_VIEW_EMPLOYEE_SELECT</option>
                </field>
           </fieldset>
	</fields>
</form>
