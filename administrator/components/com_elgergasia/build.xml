<?xml version="1.0" encoding="UTF-8" ?>
<project name="elgergasia" default="package" basedir="." >
        <taskdef name="xmltask" classname="com.oopsconsultancy.xmltask.ant.XmlTask"/>
        <property name="extname" value="elgergasia" />
        <property name="version" value="0.0.1" />
        <property name="jVer" value="j30" />
        <property name="exttype" value="com" />
        <property name="container" value="components"/>
        <property name="siteroot" value="./../../.." />
        <property name="srcadmin" value="." />
        
        <property name="srcsite" value="${siteroot}/${container}/${exttype}_${extname}" />
        <property name="builddir" value="${user.home}/projects/projects_joomla/${extname}" />
        <property name="versiondata" value="${exttype}_${extname}_v${version}_${jVer}" />
        <property name="filesdir" value="${builddir}/files/${versiondata}" />
        <property name="zipfilepath" value="${builddir}/${versiondata}.zip" />
	<property name="buildadmin" value="${filesdir}/admin" />
	<property name="buildsite" value="${filesdir}/site" />
         <tstamp>
            <format property="TODAY_SMALL" pattern="yyyy-MM-dd" locale="el,GR" />
        </tstamp>
        
        <target name="clean" description="Removes previous build">
            <delete dir="${filesdir}" includeemptydirs="true" failonerror="false" />
            <delete file="${zipfilepath}" failonerror="false" />
            <mkdir dir="${filesdir}" />
        </target>
        
	<target name="init"  >
            <mkdir dir="${buildadmin}" />
            <mkdir dir="${buildsite}" />
	</target>
	<target name="site">
            <copy todir="${buildsite}" >
		<fileset dir="${srcsite}" ></fileset>
            </copy>
	</target>
         <target name="media">
            <copy todir="${buildsite}/media" >
		<fileset dir="${siteroot}/media/${exttype}_${extname}" ></fileset>
            </copy>
            <delete dir="${siteroot}/media/${exttype}_${extname}" />
        </target>
	<target name="administrator">
            <copy todir="${buildadmin}" >
		<fileset dir="${srcadmin}" ></fileset>
            </copy>
            <move file="${buildadmin}/${exttype}_${extname}.xml" tofile="${buildadmin}/../${exttype}_${extname}.xml" />
            <delete file="${buildadmin}/build.xml" />
            <delete file="${buildadmin}/buildExtension.xml" />
<!--            <delete verbose="true" dir="${buildadmin}/package" /> -->
        </target>
        <target name="xmlparams">
             <xmltask source="${filesdir}/${exttype}_${extname}.xml" dest="${filesdir}/${exttype}_${extname}.xml" >
                <replace path="//extension/creationDate/text()" withText="${TODAY_SMALL}" />
                <replace path="//extension/version/text()" withText="${version}" />
             </xmltask>
        </target>

        <target name="zipfiles">
            <zip destfile="${zipfilepath}" basedir="${filesdir}" excludes="**/build.xml" />
        </target>
	<target name="package" depends="clean,init,site,media, administrator,xmlparams,zipfiles"  description="Builds main project"></target>
</project>
